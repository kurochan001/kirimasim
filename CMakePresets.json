{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Development (-O1 -g)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-O1 -g",
                "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (-O3)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "AddressSanitizer",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=address -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=address -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address",
                "SLANG_USE_MIMALLOC": "OFF"
            }
        },
        {
            "name": "ubsan",
            "inherits": "base",
            "displayName": "UndefinedBehaviorSanitizer",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=undefined -fno-sanitize-recover=all",
                "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=undefined -fno-sanitize-recover=all",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
            }
        },
        {
            "name": "tsan",
            "inherits": "base",
            "displayName": "ThreadSanitizer (the Context tests only)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=thread",
                "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=thread",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
                "SLANG_USE_MIMALLOC": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "ubsan", "configurePreset": "ubsan" },
        { "name": "tsan", "configurePreset": "tsan", "targets": ["kirimasim_context_tests"] }
    ],
    "testPresets": [
        { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true }, "execution": { "timeout": 300 } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true }, "execution": { "timeout": 300 } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true }, "execution": { "timeout": 300 } },
        { "name": "ubsan", "configurePreset": "ubsan", "output": { "outputOnFailure": true }, "execution": { "timeout": 300 } },
        { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true }, "execution": { "timeout": 300 }, "filter": { "include": { "label": "Context" } } }
    ]
}
