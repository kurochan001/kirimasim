; sir format 0
precision 1ns
source 0 "disable_scopes.sv"
instance 0 "top" def="top" parent=-

subroutine @0 "top.t" task automatic may-wait inst=0 ret=void {  ; 0:6:18
  param input "n" : s2<32> -> %f0
  frame %f0 "n" : s2<32>
  frame %f1 "i" : s2<32>
bb0:
  fstore %f1, const s2<32> 32'h00000000  ; 0:7:14
  br bb1  ; 0:7:5
bb1:
  %t0 = fload s2<32> %f1  ; 0:7:21
  %t1 = fload s2<32> %f0  ; 0:7:25
  %t2 = lt i2<1> %t0, %t1  ; 0:7:21
  br.if %t2, bb2, bb3  ; 0:7:5
bb2:
  scope.enter #1, bb4  ; 0:7:33
  %t3 = fload s2<32> %f1  ; 0:8:11
  %t4 = eq i2<1> %t3, const s2<32> 32'h00000002  ; 0:8:11
  br.if %t4, bb5, bb6  ; 0:8:7
bb3:
  ret  ; 0:6:18
bb4:
  br bb12  ; 0:7:5
bb5:
  scope.leave #1  ; 0:8:19
  br bb3  ; 0:8:19
bb6:
  br bb7  ; 0:8:7
bb7:
  %t5 = fload s2<32> %f1  ; 0:9:11
  %t6 = eq i2<1> %t5, const s2<32> 32'h00000003  ; 0:9:11
  br.if %t6, bb8, bb9  ; 0:9:7
bb8:
  scope.leave #1  ; 0:9:19
  ret  ; 0:9:19
bb9:
  br bb10  ; 0:9:7
bb10:
  wait.delay const i2<64> 64'h0000000000000001, bb11  ; 0:10:7
bb11:
  disable.scope #1  ; 0:10:10
  br bb4  ; 0:10:10
bb12:
  %t7 = fload s2<32> %f1  ; 0:7:28
  %t8 = add s2<32> %t7, const s2<32> 32'h00000001  ; 0:7:28
  fstore %f1, %t8  ; 0:7:28
  br bb1  ; 0:7:5
}

process @0 "top.initial0" kind=initial inst=0 {  ; 0:13:3
bb0:
  scope.enter #0, bb1  ; 0:13:11
  br bb2  ; 0:15:7
bb1:
  ret  ; 0:13:3
bb2:
  wait.delay const i2<64> 64'h0000000000000005, bb3  ; 0:17:5
bb3:
  scope.leave #0  ; 0:13:11
  br bb1  ; 0:13:11
}

process @1 "top.initial1" kind=initial inst=0 {  ; 0:19:3
bb0:
  wait.delay const i2<64> 64'h0000000000000002, bb1  ; 0:20:5
bb1:
  disable.scope #0  ; 0:20:8
  disable.task @0  ; 0:21:5
  ret  ; 0:19:3
}
