; sir format 0
precision 1ns
source 0 "static_init.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.clk" : i4<1> var inst=0
slot %s1 "top.a" : s2<32> var inst=0
slot %s2 "top.b" : s2<32> var inst=0
slot %s3 "top.q" : i4<4> var inst=0
slot %s4 "top.k" : s2<32> var inst=0

process @0 "top.$static" kind=static-init inst=0 writes=%s1,%s2,%s3,%s4 {  ; 0:6:7
bb0:
  store %s1, const s2<32> 32'h00000005  ; 0:6:7
  %t0 = load s2<32> %s1  ; 0:7:11
  %t1 = add s2<32> %t0, const s2<32> 32'h00000002  ; 0:7:11
  store %s2, %t1  ; 0:7:7
  store %s3, const i4<4> 4'h3  ; 0:8:15
  store %s4, const s2<32> 32'h0000000a  ; 0:11:16
  ret  ; 0:4:8
}

process @1 "top.always_ff0" kind=ff inst=0 trigger=posedge(%s0) writes=%s3 {  ; 0:9:3
bb0:
  %t0 = load i4<4> %s3  ; 0:9:33
  %t1 = add i4<4> %t0, const i4<4> 4'h1  ; 0:9:33
  nba %s3, %t1  ; 0:9:28
  ret  ; 0:9:3
}

process @2 "top.initial0" kind=initial inst=0 writes=%s4 {  ; 0:10:3
bb0:
  %t0 = load s2<32> %s4  ; 0:12:9
  %t1 = load s2<32> %s2  ; 0:12:13
  %t2 = add s2<32> %t0, %t1  ; 0:12:9
  store %s4, %t2  ; 0:12:5
  ret  ; 0:10:3
}
