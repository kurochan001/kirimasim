; sir format 0
precision 1ns
source 0 "unnamed_blocks.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.sum" : s2<32> var inst=0
slot %s1 "top.sum~2" : s2<32> var inst=0

process @0 "top.initial0" kind=initial inst=0 writes=%s0,%s1 {  ; 0:4:3
bb0:
  store %s0, const s2<32> 32'h00000001  ; 0:7:7
  store %s1, const s2<32> 32'h00000002  ; 0:11:7
  ret  ; 0:4:3
}
