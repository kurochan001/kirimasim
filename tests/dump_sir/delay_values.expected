; sir format 0
precision 100ps
source 0 "delay_values.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.d" : s2<32> var inst=0
slot %s1 "top.r" : real var inst=0

process @0 "top.$static" kind=static-init inst=0 writes=%s0,%s1 {  ; 0:5:7
bb0:
  store %s0, const s2<32> 32'h00000003  ; 0:5:7
  store %s1, const real 2.75  ; 0:6:8
  ret  ; 0:4:8
}

process @1 "top.initial0" kind=initial inst=0 {  ; 0:7:3
bb0:
  %t0 = load s2<32> %s0  ; 0:8:6
  %t1 = sext i2<64> %t0  ; 0:8:5
  %t2 = to4 i4<64> %t1  ; 0:8:5
  %t3 = mul i4<64> %t2, const i4<64> 64'h000000000000000a  ; 0:8:5
  wait.delay %t3, bb1  ; 0:8:5
bb1:
  %t4 = load real %s1  ; 0:9:6
  %t5 = mul real %t4, const real 10  ; 0:9:5
  %t6 = rtoi i4<64> %t5  ; 0:9:5
  wait.delay %t6, bb2  ; 0:9:5
bb2:
  ret  ; 0:7:3
}
