; sir format 0
precision 1ns
source 0 "deferred_assertions.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.v" : s2<32> var inst=0

subroutine @0 "top.initial0.$deferred0" function automatic inst=0 ret=void {  ; 0:7:5
  param input "$0" : s2<32> -> %f0
  frame %f0 "" : s2<32>
bb0:
  %t0 = fload s2<32> %f0  ; 0:7:5
  syscall "$display", "v=%0d", %t0  ; 0:7:24
  ret  ; 0:7:5
}

subroutine @1 "top.initial0.$deferred1" function automatic inst=0 ret=void {  ; 0:7:5
bb0:
  syscall "$display", "fail"  ; 0:7:55
  ret  ; 0:7:5
}

subroutine @2 "top.initial0.$deferred2" function automatic inst=0 ret=void {  ; 0:8:5
bb0:
  syscall "$error", "top"  ; 0:8:5
  ret  ; 0:8:5
}

process @0 "top.initial0" kind=initial inst=0 {  ; 0:6:3
bb0:
  %t0 = load s2<32> %s0  ; 0:7:16
  %t1 = eq i2<1> %t0, const s2<32> 32'h00000000  ; 0:7:16
  br.if %t1, bb1, bb2  ; 0:7:5
bb1:
  %t2 = load s2<32> %s0  ; 0:7:42
  %t3 = add s2<32> %t2, const s2<32> 32'h00000001  ; 0:7:42
  report.call "#0", @0, %t3  ; 0:7:5
  br bb3  ; 0:7:5
bb2:
  report.call "#0", @1  ; 0:7:5
  br bb3  ; 0:7:5
bb3:
  %t4 = load s2<32> %s0  ; 0:8:19
  %t5 = ne i2<1> %t4, const s2<32> 32'h00000000  ; 0:8:19
  br.if %t5, bb4, bb5  ; 0:8:5
bb4:
  br bb6  ; 0:8:5
bb5:
  report.call "final", @2  ; 0:8:5
  br bb6  ; 0:8:5
bb6:
  ret  ; 0:6:3
}
