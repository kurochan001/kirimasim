; sir format 0
precision 1ns
source 0 "fork.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.n" : s2<32> var inst=0

process @0 "top.initial0" kind=initial inst=0 {  ; 0:6:3
bb0:
  fork @1, @2, "join_any", bb1  ; 0:7:5
bb1:
  wait.fork bb2  ; 0:13:5
bb2:
  disable.fork  ; 0:14:5
  ret  ; 0:6:3
}

process @1 "top.initial0.fork0.0" kind=general inst=0 parent=process @0 writes=%s0 {  ; 0:8:7
bb0:
  wait.delay const i2<64> 64'h0000000000000001, bb1  ; 0:8:7
bb1:
  store %s0, const s2<32> 32'h00000001  ; 0:8:10
  ret  ; 0:7:5
}

process @2 "top.initial0.fork0.1" kind=general inst=0 parent=process @0 writes=%s0 {  ; 0:10:9
bb0:
  wait.delay const i2<64> 64'h0000000000000002, bb1  ; 0:10:9
bb1:
  store %s0, const s2<32> 32'h00000002  ; 0:10:12
  ret  ; 0:7:5
}
