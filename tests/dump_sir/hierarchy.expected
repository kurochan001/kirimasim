process @0 "top.g[0].u.$port.i" kind=cont inst=0 trigger=any(%s0) writes=%s3 {  ; 0:14:15
bb0:
  %t0 = load i4<1> %s0  ; 0:14:15
  store %s3, %t0  ; 0:14:15
  ret  ; 0:14:15
}

