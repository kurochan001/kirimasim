; sir format 0
precision 1ns
source 0 "structs.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.p.a.x" : s2<32> var inst=0
slot %s1 "top.p.a.y" : s2<32> var inst=0
slot %s2 "top.p.tag" : i4<4> var inst=0
slot %s3 "top.p.b" : s2<8> [0:1] var inst=0
slot %s4 "top.q.a.x" : s2<32> var inst=0
slot %s5 "top.q.a.y" : s2<32> var inst=0
slot %s6 "top.q.tag" : i4<4> var inst=0
slot %s7 "top.q.b" : s2<8> [0:1] var inst=0

subroutine @0 "top.t" task automatic inst=0 ret=void {  ; 0:8:18
  frame %f0 "local_p.x" : s2<32>
  frame %f1 "local_p.y" : s2<32>
bb0:
  fstore %f0, const s2<32> 32'h00000000  ; 0:9:13
  fstore %f1, const s2<32> 32'h00000000  ; 0:9:13
  fstore %f1, const s2<32> 32'h00000002  ; 0:9:13
  fstore %f0, const s2<32> 32'h00000001  ; 0:10:5
  ret  ; 0:8:18
}

process @0 "top.$static" kind=static-init inst=0 writes=%s1,%s5 {  ; 0:7:9
bb0:
  store %s1, const s2<32> 32'h00000002  ; 0:7:9
  store %s5, const s2<32> 32'h00000002  ; 0:7:12
  ret  ; 0:4:8
}

process @1 "top.initial0" kind=initial inst=0 writes=%s0,%s4,%s5,%s6,%s7{0},%s7{1} {  ; 0:12:3
bb0:
  store %s0, const s2<32> 32'h00000005  ; 0:13:5
  %t0 = load s2<32> %s0  ; 0:14:5
  %t1 = load s2<32> %s1  ; 0:14:5
  %t2 = load i4<4> %s2  ; 0:14:5
  %t3 = load.elem s2<8> %s3, const s2<64> 64'h0000000000000000  ; 0:14:5
  %t4 = load.elem s2<8> %s3, const s2<64> 64'h0000000000000001  ; 0:14:5
  store %s4, %t0  ; 0:14:5
  store %s5, %t1  ; 0:14:5
  store %s6, %t2  ; 0:14:5
  store.elem %s7, const s2<64> 64'h0000000000000000, %t3  ; 0:14:5
  store.elem %s7, const s2<64> 64'h0000000000000001, %t4  ; 0:14:5
  call @0  ; 0:15:5
  ret  ; 0:12:3
}
