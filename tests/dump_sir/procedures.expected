; sir format 0
precision 100ps
source 0 "procedures.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.clk" : i4<1> var inst=0
slot %s1 "top.a" : i4<4> var inst=0
slot %s2 "top.b" : i4<4> var inst=0
slot %s3 "top.c" : i4<4> var inst=0
slot %s4 "top.mem" : i4<8> [0:3] var inst=0
slot %s5 "top.i" : s2<32> var inst=0

process @0 "top.always_comb0" kind=comb inst=0 trigger=any(%s1),any(%s4{1}) writes=%s3,%s2 {  ; 0:12:3
bb0:
  %t0 = load i4<4> %s2  ; 0:13:9
  store %s3, %t0  ; 0:13:5
  %t1 = load i4<4> %s1  ; 0:14:9
  %t2 = load.elem i4<8> %s4, const s2<32> 32'h00000001  ; 0:14:13
  %t3 = partsel i4<4> %t2, const i2<32> 32'h00000000  ; 0:14:13
  %t4 = xor i4<4> %t1, %t3  ; 0:14:9
  store %s2, %t4  ; 0:14:5
  ret  ; 0:12:3
}

process @1 "top.always0" kind=ff-plain inst=0 trigger=posedge(%s0) writes=%s1[2:2] {  ; 0:16:3
bb0:
  %t0 = load i4<4> %s1  ; 0:16:34
  %t1 = bitsel i4<1> %t0, const s2<64> 64'h0000000000000002  ; 0:16:34
  %t2 = not i4<1> %t1  ; 0:16:33
  nba %s1[2:2], %t2  ; 0:16:25
  ret  ; 0:16:3
}

process @2 "top.always1" kind=general inst=0 writes=%s0 {  ; 0:17:3
bb0:
  br bb1  ; 0:17:3
bb1:
  wait.delay const i2<64> 64'h0000000000000019, bb2  ; 0:18:5
bb2:
  store %s0, const i4<1> 1'h0  ; 0:18:10
  wait.event negedge %s0, posedge %s1[0:0], bb3  ; 0:19:6
bb3:
  br bb1  ; 0:17:3
}

process @3 "top.initial0" kind=initial inst=0 writes=%s5 {  ; 0:21:3
bb0:
  %t0 = load i4<4> %s1  ; 0:22:12
  %t1 = match.mask i2<1> %t0, const i4<4> 4'b1zz0, "casez"  ; 0:23:7
  br.if %t1, bb1, bb2  ; 0:23:7
bb1:
  store %s5, const s2<32> 32'h00000001  ; 0:23:16
  br bb3  ; 0:22:5
bb2:
  store %s5, const s2<32> 32'h00000002  ; 0:24:16
  br bb3  ; 0:22:5
bb3:
  ret  ; 0:21:3
}
