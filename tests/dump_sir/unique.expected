; sir format 0
precision 1ns
source 0 "unique.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.sel" : i4<2> var inst=0
slot %s1 "top.hit" : s2<32> var inst=0

process @0 "top.always_comb0" kind=comb inst=0 trigger=any(%s0) writes=%s1 {  ; 0:7:3
bb0:
  %t0 = load i4<2> %s0  ; 0:8:18
  %t1 = ceq i2<1> %t0, const i4<2> 2'h0  ; 0:9:7
  %t2 = ceq i2<1> %t0, const i4<2> 2'h1  ; 0:10:7
  %t3 = ceq i2<1> %t0, const i4<2> 2'h3  ; 0:10:14
  %t4 = or i2<1> %t2, %t3  ; 0:8:5
  %t5 = and i2<1> %t1, %t4  ; 0:8:5
  %t6 = or i2<1> const i2<1> 1'h0, %t5  ; 0:8:5
  %t7 = or i2<1> %t1, %t4  ; 0:8:5
  br.if %t6, bb3, bb4  ; 0:8:5
bb1:
  store %s1, const s2<32> 32'h00000000  ; 0:9:14
  br bb9  ; 0:8:5
bb2:
  store %s1, const s2<32> 32'h00000001  ; 0:10:21
  br bb9  ; 0:8:5
bb3:
  report.defer "unique case", "more than one item matches", "top"  ; 0:8:5
  br bb4  ; 0:8:5
bb4:
  br.if %t7, bb6, bb5  ; 0:8:5
bb5:
  report.defer "unique case", "no item matches", "top"  ; 0:8:5
  br bb6  ; 0:8:5
bb6:
  br.if %t1, bb1, bb7  ; 0:8:5
bb7:
  br.if %t4, bb2, bb8  ; 0:8:5
bb8:
  br bb9  ; 0:8:5
bb9:
  ret  ; 0:7:3
}
