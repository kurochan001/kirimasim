; sir format 0
precision 1ns
source 0 "events.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.e" : event var inst=0
slot %s1 "top.ea" : event [1:2] var inst=0
slot %s2 "top.t" : i2<1> var inst=0

process @0 "top.initial0" kind=initial inst=0 writes=%s2 {  ; 0:7:3
bb0:
  wait.named %s1{1}, bb1  ; 0:8:7
bb1:
  %t0 = load event %s0  ; 0:9:9
  %t1 = builtin i2<1> "triggered", %t0  ; 0:9:9
  store %s2, %t1  ; 0:9:5
  ret  ; 0:7:3
}

process @1 "top.initial1" kind=initial inst=0 {  ; 0:11:3
bb0:
  trigger %s0  ; 0:12:5
  trigger.nb %s1{1}  ; 0:13:5
  trigger.nb %s0, const i2<64> 64'h0000000000000003  ; 0:14:5
  ret  ; 0:11:3
}
