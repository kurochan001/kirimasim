; sir format 0
precision 1ns
source 0 "refs_arrays.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.s" : s2<32> var inst=0
slot %s1 "top.sa" : s2<32> [0:3] var inst=0

subroutine @0 "top.add" function automatic inst=0 ret=void {  ; 0:7:27
  param ref "v" : s2<32> -> %f0
  param input "k" : s2<32> -> %f1
  frame %f0 "v" : ref<s2<32>>
  frame %f1 "k" : s2<32>
bb0:
  %t0 = load.ref s2<32> %f0  ; 0:8:9
  %t1 = fload s2<32> %f1  ; 0:8:13
  %t2 = add s2<32> %t0, %t1  ; 0:8:9
  store.ref %f0, %t2  ; 0:8:5
  store.ref.bits %f0, const s2<64> 64'h0000000000000000, const i2<1> 1'h1  ; 0:9:5
  ret  ; 0:7:27
}

subroutine @1 "top.pick" function automatic inst=0 ret=s2<32> {  ; 0:11:26
  param const.ref "a" : s2<32> -> %f0
  param input "i" : s2<32> -> %f1
  frame %f0 "a" : ref<s2<32>> [0:3]
  frame %f1 "i" : s2<32>
  frame %f2 "pick" : s2<32>
bb0:
  %t0 = fload s2<32> %f1  ; 0:12:14
  %t1 = load.ref.elem s2<32> %f0, %t0  ; 0:12:12
  ret %t1  ; 0:12:5
}

subroutine @2 "top.total" function automatic inst=0 ret=s2<32> {  ; 0:14:26
  param input "a" : s2<32> -> %f0
  frame %f0 "a" : s2<32> [0:3]
  frame %f1 "total" : s2<32>
  frame %f2 "t" : s2<32> [0:1]
bb0:
  store.elem %f2, const s2<64> 64'h0000000000000000, const s2<32> 32'h00000000  ; 0:15:9
  store.elem %f2, const s2<64> 64'h0000000000000001, const s2<32> 32'h00000000  ; 0:15:9
  %t0 = load.elem s2<32> %f0, const s2<32> 32'h00000000  ; 0:16:12
  %t1 = load.elem s2<32> %f0, const s2<32> 32'h00000001  ; 0:16:19
  %t2 = add s2<32> %t0, %t1  ; 0:16:12
  store.elem %f2, const s2<32> 32'h00000000, %t2  ; 0:16:5
  %t3 = load.elem s2<32> %f0, const s2<32> 32'h00000002  ; 0:17:17
  %t4 = partsel i2<4> %t3, const i2<32> 32'h00000000  ; 0:17:17
  store.bits %f2, const s2<32> 32'h00000001, const s2<64> 64'h0000000000000000, %t4  ; 0:17:5
  %t5 = load.elem s2<32> %f2, const s2<32> 32'h00000000  ; 0:18:12
  %t6 = load.elem s2<32> %f2, const s2<32> 32'h00000001  ; 0:18:19
  %t7 = add s2<32> %t5, %t6  ; 0:18:12
  ret %t7  ; 0:18:5
}

process @0 "top.initial0" kind=initial inst=0 writes=%s0,%s1 {  ; 0:20:3
  frame %f0 "" : s2<32> [0:3]
bb0:
  %t0 = ref.make ref %s0  ; 0:21:5
  call @0, %t0, const s2<32> 32'h00000001  ; 0:21:5
  %t1 = ref.make ref %s1, const s2<32> 32'h00000002  ; 0:22:5
  call @0, %t1, const s2<32> 32'h00000003  ; 0:22:5
  %t2 = ref.make ref %s1  ; 0:23:9
  %t3 = call s2<32> @1, %t2, const s2<32> 32'h00000001  ; 0:23:9
  %t4 = call s2<32> @2, %s1  ; 0:23:23
  %t5 = add s2<32> %t3, %t4  ; 0:23:9
  store.elem %f0, const s2<64> 64'h0000000000000000, const s2<32> 32'h00000001  ; 0:23:35
  store.elem %f0, const s2<64> 64'h0000000000000001, const s2<32> 32'h00000002  ; 0:23:35
  store.elem %f0, const s2<64> 64'h0000000000000002, const s2<32> 32'h00000003  ; 0:23:35
  store.elem %f0, const s2<64> 64'h0000000000000003, const s2<32> 32'h00000004  ; 0:23:35
  %t6 = call s2<32> @2, %f0  ; 0:23:35
  %t7 = add s2<32> %t5, %t6  ; 0:23:9
  store %s0, %t7  ; 0:23:5
  ret  ; 0:20:3
}
