; sir format 0
precision 1ns
source 0 "reals.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.r" : real var inst=0
slot %s1 "top.s" : shortreal var inst=0
slot %s2 "top.i" : s2<32> var inst=0

process @0 "top.initial0" kind=initial inst=0 writes=%s0,%s2,%s1 {  ; 0:7:3
bb0:
  %t0 = load s2<32> %s2  ; 0:8:9
  %t1 = itor real %t0  ; 0:8:9
  %t2 = add real %t1, const real 0.5  ; 0:8:9
  store %s0, %t2  ; 0:8:5
  %t3 = load real %s0  ; 0:9:9
  %t4 = rtoi s2<32> %t3  ; 0:9:9
  store %s2, %t4  ; 0:9:5
  %t5 = load real %s0  ; 0:10:9
  %t6 = rconv shortreal %t5  ; 0:10:9
  store %s1, %t6  ; 0:10:5
  %t7 = load real %s0  ; 0:11:9
  %t8 = gt i2<1> %t7, const real 1  ; 0:11:9
  br.if %t8, bb1, bb2  ; 0:11:5
bb1:
  store %s2, const s2<32> 32'h00000000  ; 0:11:18
  br bb3  ; 0:11:5
bb2:
  br bb3  ; 0:11:5
bb3:
  %t9 = load real %s0  ; 0:12:9
  %t10 = truth i2<1> %t9  ; 0:12:9
  br.if %t10, bb4, bb5  ; 0:12:5
bb4:
  store %s2, const s2<32> 32'h00000001  ; 0:12:12
  br bb6  ; 0:12:5
bb5:
  br bb6  ; 0:12:5
bb6:
  ret  ; 0:7:3
}
