; sir format 0
precision 1ns
source 0 "wait_cond.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.a" : i4<4> var inst=0

subroutine @0 "top.initial0.wait0" guard static inst=0 ret=i4<1> frame-of=process @0 {  ; 0:9:5
bb0:
  %t0 = load i4<4> %s0  ; 0:9:11
  %t1 = bitsel i4<1> %t0, const s2<64> 64'h0000000000000001  ; 0:9:11
  ret %t1  ; 0:9:5
}

subroutine @1 "top.t" task automatic may-wait inst=0 ret=void {  ; 0:5:18
  param input "k" : s2<32> -> %f0
  frame %f0 "k" : s2<32>
bb0:
  wait.cond @2, bb1  ; 0:6:5
bb1:
  ret  ; 0:5:18
}

subroutine @2 "top.t.wait0" guard static inst=0 ret=i4<1> frame-of=subroutine @1 {  ; 0:6:5
bb0:
  %t0 = load i4<4> %s0  ; 0:6:11
  %t1 = fload s2<32> %f0  ; 0:6:16
  %t2 = partsel i2<4> %t1, const i2<32> 32'h00000000  ; 0:6:16
  %t3 = to4 i4<4> %t2  ; 0:6:16
  %t4 = eq i4<1> %t0, %t3  ; 0:6:11
  ret %t4  ; 0:6:5
}

process @0 "top.initial0" kind=initial inst=0 {  ; 0:8:3
bb0:
  wait.cond @0, bb1  ; 0:9:5
bb1:
  syscall "$display", "a[1]"  ; 0:9:17
  call.task @1, const s2<32> 32'h00000003, bb2  ; 0:10:5
bb2:
  ret  ; 0:8:3
}
