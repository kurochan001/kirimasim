; sir format 0
precision 1ns
source 0 "postponed.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.a" : s2<32> var inst=0

process @0 "top.initial0" kind=initial inst=0 {  ; 0:6:3
bb0:
  strobe @1  ; 0:7:5
  monitor @2  ; 0:8:5
  syscall "$monitoroff"  ; 0:9:5
  syscall "$monitoron"  ; 0:10:5
  ret  ; 0:6:3
}

process @1 "top.$strobe0" kind=postponed inst=0 {  ; 0:7:5
bb0:
  %t0 = load s2<32> %s0  ; 0:7:20
  syscall "$display", "%0d", %t0  ; 0:7:5
  ret  ; 0:7:5
}

process @2 "top.$monitor0" kind=postponed inst=0 {  ; 0:8:5
  frame %f0 "" : s2<32>
  frame %f1 "" : i2<1>
bb0:
  %t0 = load s2<32> %s0  ; 0:8:32
  %t1 = fload s2<32> %f0  ; 0:8:5
  %t2 = cne i2<1> %t0, %t1  ; 0:8:5
  %t3 = fload i2<1> %f1  ; 0:8:5
  %t4 = lnot i2<1> %t3  ; 0:8:5
  %t5 = or i2<1> %t4, %t2  ; 0:8:5
  br.if %t5, bb1, bb2  ; 0:8:5
bb1:
  fstore %f0, %t0  ; 0:8:5
  fstore %f1, const i2<1> 1'h1  ; 0:8:5
  %t6 = syscall i4<64> "$time", const i2<64> 64'h0000000000000001  ; 0:8:25
  %t7 = load s2<32> %s0  ; 0:8:32
  syscall "$display", "%0t %0d", %t6, %t7  ; 0:8:5
  br bb2  ; 0:8:5
bb2:
  ret  ; 0:8:5
}
