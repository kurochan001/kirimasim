; sir format 0
precision 1ns
source 0 "param_arrays.sv"
instance 0 "top" def="top" parent=-
slot %s0 "top.k" : s2<32> var inst=0
slot %s1 "top.P" : s2<32> [0:2] var inst=0

process @0 "top.initial0" kind=initial inst=0 {  ; 0:7:3
bb0:
  %t0 = load s2<32> %s0  ; 0:7:39
  %t1 = load.elem s2<32> %s1, %t0  ; 0:7:37
  syscall "$display", "%0d %0d", const s2<32> 32'h00000005, %t1  ; 0:7:11
  ret  ; 0:7:3
}

process @1 "top.$static" kind=static-init inst=0 writes=%s1 {  ; 0:5:18
bb0:
  store %s1{0}, const s2<32> 32'h00000004  ; 0:5:18
  store %s1{1}, const s2<32> 32'h00000005  ; 0:5:18
  store %s1{2}, const s2<32> 32'h00000006  ; 0:5:18
  ret  ; 0:4:8
}
