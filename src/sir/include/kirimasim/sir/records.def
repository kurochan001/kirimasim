// Kinds of the records that have kinds (M3): KIRIMASIM_SIR_KIND(Struct, Kind, "text") and the fields
// each kind writes, in text order: KIRIMASIM_SIR_KIND_FIELD(Struct, Kind, member). From what the format-0
// printer writes for each kind; a field that a kind does not list cannot be written for it.
KIRIMASIM_SIR_KIND(Operand, Operand::Kind::Temp, "temp")
KIRIMASIM_SIR_KIND_FIELD(Operand, Operand::Kind::Temp, id)
KIRIMASIM_SIR_KIND(Operand, Operand::Kind::Const, "const")
