// The records of SIR format 1, one line per field (docs/notes/sir-v1-proposal.md, "The schema", and
// the H1b step 2 decisions of 2026-11-08). A field's name in the text is its member name.
//   KIRIMASIM_SIR_RECORD(Struct, "text")   a record
//   KIRIMASIM_SIR_FIELD(Struct, member, kind)  kind: value (written) or derived (recomputed)
// Struct names are those of design.h. Fields come in D1's order, then the members D1 does not
// list yet, in their order in design.h. src/sir/records.cpp checks each line against design.h
// at compile time; tools/sir_schema_drift.py reads the file as the schema of the fields.

KIRIMASIM_SIR_RECORD(Design, "design")
KIRIMASIM_SIR_FIELD(Design, timePrecision, value)
KIRIMASIM_SIR_FIELD(Design, sources, value)
KIRIMASIM_SIR_FIELD(Design, instances, value)
KIRIMASIM_SIR_FIELD(Design, types, value)
KIRIMASIM_SIR_FIELD(Design, patterns, value)
KIRIMASIM_SIR_FIELD(Design, slots, value)
KIRIMASIM_SIR_FIELD(Design, names, value)
KIRIMASIM_SIR_FIELD(Design, constants, value)
KIRIMASIM_SIR_FIELD(Design, subroutines, value)
KIRIMASIM_SIR_FIELD(Design, processes, value)
KIRIMASIM_SIR_FIELD(Design, numScopes, value)
KIRIMASIM_SIR_FIELD(Design, dumpScopes, value)
KIRIMASIM_SIR_FIELD(Design, dumpVars, value)
KIRIMASIM_SIR_FIELD(Design, foreignObjects, value)
KIRIMASIM_SIR_FIELD(Design, foreignArguments, value)
KIRIMASIM_SIR_FIELD(Design, nbaLayouts, value)
KIRIMASIM_SIR_FIELD(Design, strengthNodes, value)
KIRIMASIM_SIR_FIELD(Design, strengthOrigins, value)
KIRIMASIM_SIR_FIELD(Design, modulePaths, value)
KIRIMASIM_SIR_FIELD(Design, strengthEdges, value)
KIRIMASIM_SIR_FIELD(Design, clockingBlocks, value)
KIRIMASIM_SIR_FIELD(Design, classes, value)
KIRIMASIM_SIR_FIELD(Design, virtualSlots, value)

